# ==========================================
# SHORTLEARN GLOBAL ENVIRONMENT CONFIGURATION
# ==========================================

# Port cấu hình
API_PORT=5000
AI_WORKER_PORT=8000
NODE_ENV=development

# Web origins được phép gọi API (Expo native không cần Origin)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081
RATE_LIMIT_PER_MINUTE=120
SUBTITLE_RATE_LIMIT_PER_HOUR=60
SUBTITLE_PROCESSING_STALE_MS=600000

# MySQL Database
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=shortlearn_secret
DB_NAME=shortlearn_db

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Message Broker
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_QUEUE_SUBTITLES=subtitles_tasks
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# JWT Secret (production: tạo secret ngẫu nhiên dài ít nhất 32 ký tự)
JWT_SECRET=replace_with_a_long_random_secret_before_production

# Authentication (use separate random secrets in production)
OTP_HMAC_SECRET=replace_with_a_different_random_secret_before_production
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_SECONDS=600
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_ATTEMPTS_PER_15_MINUTES=15
OTP_REQUESTS_PER_15_MINUTES=5
REFRESH_REQUESTS_PER_MINUTE=30

# Development prints OTP to the backend console. Production must use webhook.
AUTH_OTP_DELIVERY_MODE=console
AUTH_EXPOSE_OTP=false
AUTH_OTP_WEBHOOK_URL=
AUTH_OTP_WEBHOOK_TOKEN=

# AI LLM Provider Keys
# Groq Cloud API: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AI Processing Preferences: 'groq' | 'gemini'
PRIMARY_LLM=groq

# Number of subtitle chunks per LLM request (1-12). A small batch protects
# structured JSON quality while reducing provider round-trips and cost.
LLM_BATCH_SIZE=6

# Offline speech-to-text fallback. base.en + CPU int8 balances English accuracy,
# startup size and latency for short videos. The model is downloaded once.
WHISPER_PROVIDER=local
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=4
WHISPER_LANGUAGE=en
WHISPER_VAD_MIN_SILENCE_MS=500
