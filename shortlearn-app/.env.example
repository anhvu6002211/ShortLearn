# Android Emulator: http://10.0.2.2:5000
# Thiết bị thật: thay 192.168.1.10 bằng IP LAN của máy chạy API Gateway.
# Thiết bị thật qua USB/ADB: chạy `adb reverse tcp:5000 tcp:5000` rồi dùng http://127.0.0.1:5000.
EXPO_PUBLIC_API_URL=http://192.168.1.10:5000

# YouTube OAuth: Client ID là định danh công khai, không thêm Client Secret vào ứng dụng.
# Android client phải khớp package com.shortlearn.app và SHA-1 của bản build.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# Google Sign-In native cũng bắt buộc Web application Client ID này.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
